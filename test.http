### Variables
@host = http://localhost:4004
@service = {{host}}/product

### Get all products
GET {{service}}/Products

### Get single product by ID
GET {{service}}/Products(d2f1b9a0-1c1a-4e1a-9b1a-000000000001)

### Filter products (price greater than 30)
GET {{service}}/Products?$filter=price gt 30

### Create a new product
POST {{service}}/Products
Content-Type: application/json

{
  "name": "Desk Lamp",
  "description": "LED desk lamp with adjustable brightness",
  "price": 24.99,
  "stock": 20
}

### Update a product (partial update)
PATCH {{service}}/Products(d2f1b9a0-1c1a-4e1a-9b1a-000000000001)
Content-Type: application/json

{
  "stock": 100
}

### Delete a product
DELETE {{service}}/Products(d2f1b9a0-1c1a-4e1a-9b1a-000000000002)
